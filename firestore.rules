rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function adminOwnerDoc() {
      return get(/databases/$(database)/documents/system/adminOwner);
    }

    function adminOwnerExists() {
      return exists(/databases/$(database)/documents/system/adminOwner);
    }

    function isAdmin() {
      return signedIn() && userDoc().data.role == "admin";
    }

    function isPrimaryAdmin() {
      return signedIn() && adminOwnerExists() && adminOwnerDoc().data.uid == request.auth.uid;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create: if isOwner(uid) && (
        request.resource.data.role == "client"
        || (
          request.resource.data.role == "admin"
          && request.resource.data.uid == uid
          && !adminOwnerExists()
          && getAfter(/databases/$(database)/documents/system/adminOwner).data.uid == uid
          && getAfter(/databases/$(database)/documents/system/adminSetup).data.configured == true
        )
      );
      allow update: if (isAdmin() || isOwner(uid)) && (
        !request.resource.data.diff(resource.data).changedKeys().hasAny(["role", "uid"])
      );
      allow delete: if (isAdmin() && resource.data.role != "admin")
        || (isPrimaryAdmin() && isOwner(uid) && resource.data.role == "admin");
    }

    match /system/{docId} {
      allow read: if docId == "adminSetup" || isAdmin();
      allow create: if signedIn() && (
        (
          docId == "adminSetup"
          && request.resource.data.configured == true
          && !exists(/databases/$(database)/documents/system/adminSetup)
          && getAfter(/databases/$(database)/documents/system/adminOwner).data.uid == request.auth.uid
        )
        || (
          docId == "adminOwner"
          && request.resource.data.uid == request.auth.uid
          && !adminOwnerExists()
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        )
      );
      allow update: if false;
      allow delete: if isPrimaryAdmin() && (docId == "adminSetup" || docId == "adminOwner");
    }

    match /clients/{clientId} {
      allow read: if isAdmin() || isOwner(resource.data.userId) || isOwner(clientId);
      allow create: if isAdmin() || isOwner(request.resource.data.userId);
      allow update: if isAdmin() || isOwner(resource.data.userId) || isOwner(clientId);
      allow delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read, write: if isAdmin();
    }

    match /publicServices/{serviceId} {
      allow read: if isAdmin() || (signedIn() && resource.data.active == true);
      allow write: if isAdmin();
    }

    match /bandMembers/{memberId} {
      allow read, write: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read, write: if isAdmin();
    }

    match /quotes/{quoteId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || (
        isOwner(request.resource.data.clientUserId)
        && request.resource.data.status == "em_analise"
        && request.resource.data.totalCosts == 0
        && request.resource.data.manualCosts.size() == 0
        && request.resource.data.adminNotes == ""
      );
      allow update: if isAdmin() || (
        isOwner(resource.data.clientUserId)
        && resource.data.status in ["aprovado_aguardando_entrada", "entrada_informada_pelo_cliente"]
        && request.resource.data.status == "entrada_informada_pelo_cliente"
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["status", "updatedAt"])
      );
      allow delete: if isAdmin();
    }

    match /clientQuoteViews/{quoteId} {
      allow read: if isAdmin() || isOwner(resource.data.clientUserId);
      allow create: if isAdmin() || (
        isOwner(request.resource.data.clientUserId)
        && request.resource.data.quoteId == quoteId
        && request.resource.data.status == "em_analise"
        && request.resource.data.keys().hasOnly([
          "quoteId",
          "clientId",
          "clientUserId",
          "clientSnapshot",
          "event",
          "items",
          "subtotal",
          "discount",
          "travelFee",
          "total",
          "depositPercent",
          "depositAmount",
          "remainingAmount",
          "status",
          "clientNotes",
          "rejectionReason",
          "paymentSummary",
          "createdAt",
          "updatedAt",
          "approvedAt",
          "depositConfirmedAt"
        ])
      );
      allow update: if isAdmin() || (
        isOwner(resource.data.clientUserId)
        && resource.data.status in ["aprovado_aguardando_entrada", "entrada_informada_pelo_cliente"]
        && request.resource.data.status == "entrada_informada_pelo_cliente"
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["status", "paymentSummary", "updatedAt"])
      );
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || isOwner(resource.data.clientId) || isOwner(resource.data.clientUserId);
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        (isOwner(resource.data.clientId) || isOwner(resource.data.clientUserId))
        && resource.data.status == "pendente"
        && request.resource.data.status == "informado_pelo_cliente"
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["status", "clientMessage", "updatedAt"])
      );
      allow delete: if isAdmin();
    }

    match /memberPayments/{paymentId} {
      allow read, write: if isAdmin();
    }

    match /supplierPayments/{paymentId} {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /publicSettings/{settingId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
